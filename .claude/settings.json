{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/bin/bootstrap.sh\" --session",
            "timeout": 600,
            "async": true
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/np-auto-setup.sh\"",
            "timeout": 1800,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/bin/_py.sh\" \"$CLAUDE_PROJECT_DIR/.claude/scripts/allow_own_script.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
